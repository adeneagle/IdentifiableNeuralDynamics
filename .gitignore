# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/

# Editor / tooling caches
.codegraph/
.vscode/
.idea/

# Neural Latents Benchmark NWB files -- large, and re-fetchable from DANDI by
# idyn.nlb.fetch() (dandisets 000128 / 000129 / 000140).  The loader records the
# asset id and byte size in every results JSON, so a run stays reproducible
# without the blobs being tracked here.
data/*.nwb

# NOT ignored, deliberately: results/*.json
#
# CLAUDE.md 8 makes the JSON record the artifact of an experiment -- it carries
# the seed and every parameter, and a result that contradicts a theory claim is
# committed rather than tuned away.  Tracking them is the point: the history of
# results/ is the record of what was actually measured and when, which is the
# only thing that makes a retraction like 3.12 auditable after the fact.

# Hsu open-field parse cache -- large, regenerated by idyn.hsu.load_session()
# from the session CSVs, which live outside the repo (see IDYN_HSU_ROOT).
data/hsu_*.npy
